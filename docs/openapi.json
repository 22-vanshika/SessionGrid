{
  "openapi": "3.0.0",
  "paths": {
    "/users/register": {
      "post": {
        "operationId": "UsersController_register",
        "summary": "Register a new user (teacher or parent)",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "409": {
            "description": "Email already registered"
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/users/login": {
      "post": {
        "operationId": "UsersController_login",
        "summary": "Validate credentials and return the user profile with a signed JWT",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Credentials valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/courses": {
      "post": {
        "operationId": "CoursesController_create",
        "summary": "Create a course (teacher only)",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCourseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Course created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Missing auth headers"
          },
          "403": {
            "description": "Caller is not a teacher"
          }
        },
        "tags": [
          "Courses"
        ]
      }
    },
    "/courses/mine": {
      "get": {
        "operationId": "CoursesController_findMine",
        "summary": "List the caller's courses (teacher only)",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of courses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourseResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing auth headers"
          },
          "403": {
            "description": "Caller is not a teacher"
          }
        },
        "tags": [
          "Courses"
        ]
      }
    },
    "/offerings": {
      "post": {
        "operationId": "OfferingsController_create",
        "summary": "Create an offering under one of the teacher's courses",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOfferingDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Offering created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferingResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Missing auth headers"
          },
          "403": {
            "description": "Caller is not a teacher or does not own the course"
          },
          "404": {
            "description": "Course not found"
          }
        },
        "tags": [
          "Offerings"
        ]
      },
      "get": {
        "operationId": "OfferingsController_findAllPublished",
        "summary": "List all published offerings with sessions in the caller's timezone",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Published offerings with localised session times",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OfferingWithSessionsResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing auth headers"
          }
        },
        "tags": [
          "Offerings"
        ]
      }
    },
    "/offerings/mine": {
      "get": {
        "operationId": "OfferingsController_findMine",
        "summary": "List the teacher's own offerings with sessions in the teacher's timezone",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Teacher's offerings with localised session times",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OfferingWithSessionsResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing auth headers"
          }
        },
        "tags": [
          "Offerings"
        ]
      }
    },
    "/offerings/{offeringId}/sessions": {
      "post": {
        "operationId": "SessionsController_addSession",
        "summary": "Add a session to an offering (times interpreted in teacher's timezone)",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offeringId",
            "required": true,
            "in": "path",
            "description": "ID of the offering",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddSessionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid datetime format"
          },
          "401": {
            "description": "Missing auth headers"
          },
          "403": {
            "description": "Caller is not a teacher or does not own the offering"
          },
          "404": {
            "description": "Offering not found"
          },
          "422": {
            "description": "Session end time before start time, or session is too far in the past"
          }
        },
        "tags": [
          "Offerings"
        ]
      }
    },
    "/bookings": {
      "post": {
        "operationId": "BookingsController_create",
        "summary": "Book a published offering (parent only)",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Missing auth headers"
          },
          "403": {
            "description": "Caller is not a parent"
          },
          "404": {
            "description": "Offering not found"
          },
          "409": {
            "description": "Duplicate booking or session time conflict"
          },
          "422": {
            "description": "Offering is not published"
          }
        },
        "tags": [
          "Bookings"
        ]
      }
    },
    "/bookings/mine": {
      "get": {
        "operationId": "BookingsController_findMine",
        "summary": "List the parent's bookings with sessions in the parent's timezone",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parent's bookings with localised session times",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BookingWithOfferingResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing auth headers"
          }
        },
        "tags": [
          "Bookings"
        ]
      }
    },
    "/bookings/{id}/cancel": {
      "patch": {
        "operationId": "BookingsController_cancel",
        "summary": "Cancel a booking (parent only, idempotent)",
        "parameters": [
          {
            "name": "x-user-timezone",
            "in": "header",
            "description": "IANA timezone string, e.g. Asia/Kolkata",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-role",
            "in": "header",
            "description": "\"teacher\" or \"parent\"",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "description": "UUID of the authenticated user",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "ID of the booking to cancel",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking cancelled (or was already cancelled)"
          },
          "401": {
            "description": "Missing auth headers"
          },
          "403": {
            "description": "Booking does not belong to the caller"
          },
          "404": {
            "description": "Booking not found"
          }
        },
        "tags": [
          "Bookings"
        ]
      }
    }
  },
  "info": {
    "title": "SessionGrid API",
    "description": "Global Class Offering Booking System — teachers create courses and sessions, parents book them with full timezone support and race-condition-proof concurrency.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "x-user-id": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-id"
      },
      "x-user-role": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-role"
      },
      "x-user-timezone": {
        "type": "apiKey",
        "in": "header",
        "name": "x-user-timezone"
      }
    },
    "schemas": {
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Alice"
          },
          "lastName": {
            "type": "string",
            "example": "Smith"
          },
          "password": {
            "type": "string",
            "example": "secret123",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "parent"
            ],
            "example": "teacher"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Kolkata",
            "description": "IANA timezone string used for all time conversions"
          }
        },
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "role",
          "timezone"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3f9e0c8d-6ce8-492f-99c9-76fb3b0c62aa"
          },
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Alice"
          },
          "lastName": {
            "type": "string",
            "example": "Smith"
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher",
              "parent"
            ],
            "example": "teacher"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-09-01T09:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-09-01T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "role",
          "timezone",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alice@example.com"
          },
          "password": {
            "type": "string",
            "example": "secret123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI...",
            "description": "HS256-signed JWT. Pass as Authorization: Bearer <token> on protected routes."
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "CreateCourseDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Algebra I"
          },
          "description": {
            "type": "string",
            "example": "Introduction to algebra for grades 6–8"
          }
        },
        "required": [
          "title"
        ]
      },
      "CourseResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "teacherId": {
            "type": "string",
            "example": "3f9e0c8d-6ce8-492f-99c9-76fb3b0c62aa"
          },
          "title": {
            "type": "string",
            "example": "Algebra I"
          },
          "description": {
            "type": "object",
            "example": "Introduction to algebra",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-09-01T09:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-09-01T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "teacherId",
          "title",
          "description",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateOfferingDto": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
            "format": "uuid"
          },
          "capacity": {
            "type": "number",
            "example": 20,
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "cancelled"
            ],
            "example": "published",
            "description": "Defaults to draft if omitted"
          }
        },
        "required": [
          "courseId",
          "capacity"
        ]
      },
      "OfferingResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "c3d4e5f6-a7b8-9012-cdef-123456789012"
          },
          "courseId": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "capacity": {
            "type": "number",
            "example": 20
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "cancelled"
            ],
            "example": "draft"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-09-01T09:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2024-09-01T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "courseId",
          "capacity",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "CourseInOfferingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "teacherId": {
            "type": "string",
            "example": "3f9e0c8d-6ce8-492f-99c9-76fb3b0c62aa"
          },
          "title": {
            "type": "string",
            "example": "Algebra I"
          },
          "description": {
            "type": "object",
            "example": "Introduction to algebra",
            "nullable": true
          }
        },
        "required": [
          "id",
          "teacherId",
          "title",
          "description"
        ]
      },
      "SessionInOfferingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "b2c3d4e5-f6a7-8901-bcde-f12345678901"
          },
          "offeringId": {
            "type": "string",
            "example": "c3d4e5f6-a7b8-9012-cdef-123456789012"
          },
