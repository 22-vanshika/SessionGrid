# ============================================================
# SessionGrid — environment variable reference
# Copy this file to .env and fill in real values.
# Every variable listed here is required unless marked optional.
# ============================================================

# --------------- Application --------------------------------
# Runtime environment: development | test | production
NODE_ENV=development

# TCP port the NestJS server listens on
APP_PORT=3000

# --------------- PostgreSQL ---------------------------------
# Hostname of the PostgreSQL server (use 'localhost' when running outside Docker)
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database username
DB_USERNAME=sessiongrid

# Database password
DB_PASSWORD=changeme

# Database name
DB_NAME=sessiongrid

# --------------- Authentication -----------------------------
# Secret used to sign JWT tokens — must be long and random in production
JWT_SECRET=long-random-secret

# How long access tokens remain valid (ms-style string, e.g. 7d, 1h)
JWT_EXPIRES_IN=7d
